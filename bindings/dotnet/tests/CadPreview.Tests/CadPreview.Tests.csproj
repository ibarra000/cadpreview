<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CadPreview.Tests</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Test names use Method_Condition_Result, and test classes need no XML docs. -->
    <NoWarn>$(NoWarn);CA1707;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.1" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CadPreview/CadPreview.csproj" />
  </ItemGroup>

  <!-- CTest passes the directory holding the freshly built native library. -->
  <ItemGroup Condition="'$(CadPreviewNativeDir)' != ''">
    <None Include="$(CadPreviewNativeDir)/cadpreview*.dll;$(CadPreviewNativeDir)/libcadpreview.so*"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
