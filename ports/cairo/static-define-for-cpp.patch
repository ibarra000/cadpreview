Applies the static-build define to C++ sources too. Without it the DirectWrite backend
compiles its public functions as dllexport, which leaks them from any DLL that links static
cairo on Windows.
--- a/src/meson.build
+++ b/src/meson.build
@@ -238,5 +238,5 @@
 cairo_static_args = []
 if get_option('default_library') == 'static' and host_machine.system() == 'windows'
   cairo_static_args += ['-DCAIRO_WIN32_STATIC_BUILD']
-  add_project_arguments('-DCAIRO_WIN32_STATIC_BUILD', language: 'c')
+  add_project_arguments('-DCAIRO_WIN32_STATIC_BUILD', language: ['c', 'cpp'])
 endif
