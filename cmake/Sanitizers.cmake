set(CADPREVIEW_INSTRUMENTED OFF)
if(CADPREVIEW_SANITIZE OR CADPREVIEW_COVERAGE OR CADPREVIEW_LIBFUZZER)
    set(CADPREVIEW_INSTRUMENTED ON)
endif()

if(CADPREVIEW_SANITIZE)
    if(MSVC AND NOT CADPREVIEW_SANITIZE STREQUAL "address")
        message(FATAL_ERROR "MSVC supports only CADPREVIEW_SANITIZE=address")
    endif()
    if(MSVC AND CMAKE_BUILD_TYPE STREQUAL "Debug")
        message(FATAL_ERROR "MSVC AddressSanitizer conflicts with /RTC1; use RelWithDebInfo")
    endif()
endif()

if(CADPREVIEW_COVERAGE AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    message(FATAL_ERROR "CADPREVIEW_COVERAGE requires GCC")
endif()

function(cadpreview_enable_instrumentation target)
    if(CADPREVIEW_SANITIZE)
        if(MSVC)
            target_compile_options(${target} PRIVATE /fsanitize=address)
        else()
            list(JOIN CADPREVIEW_SANITIZE "," sanitizers)
            target_compile_options(${target} PRIVATE
                -fsanitize=${sanitizers} -fno-omit-frame-pointer -fno-sanitize-recover=all)
            target_link_options(${target} PRIVATE -fsanitize=${sanitizers})
        endif()
    endif()
    if(CADPREVIEW_COVERAGE)
        # Atomic counters keep coverage exact for the multithreaded tests.
        target_compile_options(${target} PRIVATE --coverage -fprofile-update=atomic -O0)
        target_link_options(${target} PRIVATE --coverage -fprofile-update=atomic)
    endif()
endfunction()
